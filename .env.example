# Copia este archivo como `.env.local` y agrega una clave NUEVA de WorkoutX.
# Nunca uses NEXT_PUBLIC_ para una clave privada.
WORKOUTX_API_KEY=

# Catálogo de alimentos y nutrientes (https://api.data.gov/signup/)
USDA_API_KEY=


# Recetas y meal prep saludable (https://spoonacular.com/food-api)
SPOONACULAR_API_KEY=

# Imágenes del armario (Cloudinary Console > API Keys)
# Estas tres variables son privadas y se configuran también en Vercel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
